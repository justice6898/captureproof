# Sandbox REST application credentials. Never use live credentials.
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PORT=3000
# Local merchant fault only; disabled by default. Use a new order when testing.
ENABLE_TEST_FAULTS=false

OPENAI_API_KEY=replace_with_openai_api_key

OPENAI_MODEL=gpt-6.1-sol

OPENAI_REASONING_EFFORT=medium
